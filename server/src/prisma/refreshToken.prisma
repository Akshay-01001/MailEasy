// use prisma-8

model RefreshToken {
  id        Uuid              @id(map: "refresh_tokens_pkey") @default(sql`gen_random_uuid()`)
  tokenHash VarChar(255)      @unique(map: "refresh_tokens_token_hash_unique") @map("token_hash")
  userId    Uuid              @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt TimestamptzString @map("expires_at")
  createdAt TimestamptzString @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
